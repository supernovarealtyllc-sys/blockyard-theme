<article class="post-card">
    {{#if feature_image}}
    <a class="post-card-image" href="{{url}}" aria-label="{{title}}">
        <img
            srcset="{{img_url feature_image size="s"}} 400w,
                    {{img_url feature_image size="m"}} 750w,
                    {{img_url feature_image size="l"}} 1140w"
            sizes="(max-width: 700px) 100vw, 33vw"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy"
        />
    </a>
    {{/if}}
    <div class="post-card-body">
        <div class="post-card-meta">
            {{#if primary_tag}}
                <a class="post-card-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                <span aria-hidden="true">·</span>
            {{/if}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
            <span aria-hidden="true">·</span>
            <span>{{reading_time}}</span>
        </div>
        <h2 class="post-card-title"><a href="{{url}}">{{title}}</a></h2>
        {{#if excerpt}}<p class="post-card-excerpt">{{excerpt}}</p>{{/if}}
    </div>
</article>
