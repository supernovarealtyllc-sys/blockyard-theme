{{!--
  End-of-content newsletter CTA (posts + pages). Self-contained narrow container.
  Peak-intent placement: reader has just finished the piece.
--}}
<div class="container-narrow">
    <aside class="subscribe-cta" aria-label="Newsletter signup">
        <span class="kicker">The dispatch</span>
        <h2 class="subscribe-cta-title">Get the next one in your inbox.</h2>
        <p class="subscribe-cta-dek">One weekly dispatch on the signals moving the block &mdash; pop culture, technology, the arts, and the rental market.</p>
        {{> "subscribe-form"}}
    </aside>
</div>
