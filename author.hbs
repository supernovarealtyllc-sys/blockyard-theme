{{!< default}}

{{#author}}
{{!-- BreadcrumbList + ProfilePage: byline entity pages carry E-E-A-T surface.
      sameAs links tie the byline to its external profiles for entity coherence. --}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{@site.url}}" },
                { "@type": "ListItem", "position": 2, "name": "{{name}}", "item": "{{url absolute="true"}}" }
            ]
        },
        {
            "@type": "ProfilePage",
            "@id": "{{url absolute="true"}}",
            "url": "{{url absolute="true"}}",
            "inLanguage": "{{@site.locale}}",
            "isPartOf": { "@id": "{{@site.url}}#website" },
            "mainEntity": {
                "@type": "Person",
                {{#if bio}}"description": "{{bio}}",{{/if}}
                {{#if profile_image}}"image": "{{img_url profile_image absolute="true"}}",{{/if}}
                {{#if website}}
                "sameAs": ["{{website}}"{{#if twitter}}, "https://twitter.com/{{twitter}}"{{/if}}{{#if facebook}}, "https://www.facebook.com/{{facebook}}"{{/if}}],
                {{else}}
                    {{#if twitter}}
                "sameAs": ["https://twitter.com/{{twitter}}"{{#if facebook}}, "https://www.facebook.com/{{facebook}}"{{/if}}],
                    {{else}}
                        {{#if facebook}}
                "sameAs": ["https://www.facebook.com/{{facebook}}"],
                        {{/if}}
                    {{/if}}
                {{/if}}
                "name": "{{name}}",
                "url": "{{url absolute="true"}}"
            }
        }
    ]
}
</script>

<section class="masthead container">
    {{#if profile_image}}<img class="masthead-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" />{{/if}}
    <span class="kicker">Byline</span>
    <h1>{{name}}</h1>
    {{#if bio}}<p class="masthead-dek">{{bio}}</p>{{/if}}
    <div class="author-links">
        {{#if website}}<a class="link-arrow" href="{{website}}" target="_blank" rel="noopener me">Website <span class="arrow" aria-hidden="true">&#8599;</span></a>{{/if}}
        {{#if twitter}}<a class="link-arrow" href="https://twitter.com/{{twitter}}" target="_blank" rel="noopener me">X (Twitter) <span class="arrow" aria-hidden="true">&#8599;</span></a>{{/if}}
        {{#if facebook}}<a class="link-arrow" href="https://www.facebook.com/{{facebook}}" target="_blank" rel="noopener me">Facebook <span class="arrow" aria-hidden="true">&#8599;</span></a>{{/if}}
    </div>
</section>
{{/author}}

<section class="container feed">
    <div class="section-head">
        <h2>Dispatches</h2>
        <span class="kicker kicker--muted">{{plural pagination.total empty='No posts' singular='% post' plural='% posts'}}</span>
    </div>
    <div class="post-grid">
        {{#foreach posts}}
            {{#if @first}}{{> "post-card" eager=true}}{{else}}{{> "post-card"}}{{/if}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
