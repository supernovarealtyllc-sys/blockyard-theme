{{!< default}}

{{#author}}
<section class="hero">
    <div class="container-narrow" style="text-align:center;">
        {{#if profile_image}}
            <img src="{{profile_image}}" alt="{{name}}" style="width:96px;height:96px;border-radius:50%;margin:0 auto 24px;" />
        {{/if}}
        <span class="overline">Author</span>
        <h1>{{name}}</h1>
        {{#if bio}}<p class="hero-subtitle">{{bio}}</p>{{/if}}
    </div>
</section>
{{/author}}

<section class="container">
    <div class="post-grid">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
