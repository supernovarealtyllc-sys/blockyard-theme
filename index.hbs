{{!< default}}

{{#is "home"}}
<section class="hero">
    <div class="container">
        <div class="hero-inner">
            <span class="kicker">A weekly dispatch from the yard</span>
            <h1 class="hero-title">The operators, capital, and code rebuilding the <span class="accent">block</span>.</h1>
            <p class="hero-dek">Field notes on proptech, wholesale, capital, and the trading stack — from the operators actually building it.</p>
            {{#unless @member}}
            <div class="hero-actions">
                {{> "subscribe-form"}}
                <a class="link-arrow" href="#latest">Read the latest <span class="arrow" aria-hidden="true">&darr;</span></a>
            </div>
            {{/unless}}
        </div>
    </div>
</section>
{{/is}}

<section class="container feed" id="latest">
    <div class="section-head">
        <h2>Latest</h2>
        <span class="kicker kicker--muted">The feed</span>
    </div>
    <div class="post-grid{{#is "home"}} post-grid--home{{/is}}">
        {{#foreach posts}}
            {{#if @first}}{{> "post-card" eager=true}}{{else}}{{> "post-card"}}{{/if}}
        {{/foreach}}
    </div>

    {{pagination}}
</section>
