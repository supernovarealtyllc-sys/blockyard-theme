<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />

    <title>{{meta_title}}</title>

    <link rel="icon" type="image/png" href="{{asset "images/favicon.png"}}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{asset "images/apple-touch-icon.png"}}" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />

    <link rel="stylesheet" type="text/css" href="{{asset "css/main.css"}}" />

    {{ghost_head}}
</head>
<body class="{{body_class}}">

    <header class="site-header">
        <div class="container site-header-inner">
            <a class="site-brand" href="{{@site.url}}">BLOCKYARD</a>
            <nav class="site-nav">
                {{navigation}}
                {{#unless @member}}
                    <a class="subscribe-btn" href="#/portal/signup" data-portal="signup">Subscribe</a>
                {{else}}
                    <a class="subscribe-btn" href="#/portal/account" data-portal="account">Account</a>
                {{/unless}}
            </nav>
            <button class="site-nav-toggle" type="button" aria-controls="site-mobile-nav" aria-expanded="false" aria-label="Menu">
                <span class="site-nav-toggle-bar"></span>
                <span class="site-nav-toggle-bar"></span>
                <span class="site-nav-toggle-bar"></span>
            </button>
        </div>
        <nav id="site-mobile-nav" class="site-mobile-nav" aria-hidden="true">
            <div class="container">
                {{navigation}}
                {{#unless @member}}
                    <a class="subscribe-btn subscribe-btn-mobile" href="#/portal/signup" data-portal="signup">Subscribe</a>
                {{else}}
                    <a class="subscribe-btn subscribe-btn-mobile" href="#/portal/account" data-portal="account">Account</a>
                {{/unless}}
            </div>
        </nav>
    </header>

    <main class="site-main">
        {{{body}}}
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a href="{{@site.url}}" class="footer-brand">BLOCKYARD</a>
                    <p class="footer-tagline">{{@site.description}}</p>
                </div>
                <div class="footer-col">
                    <h4>Sections</h4>
                    <ul>
                        <li><a href="{{@site.url}}/tag/field-notes/">Field Notes</a></li>
                        <li><a href="{{@site.url}}/tag/operators/">Operators</a></li>
                        <li><a href="{{@site.url}}/tag/capital/">Capital</a></li>
                        <li><a href="{{@site.url}}/tag/code/">Code</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Follow</h4>
                    <ul>
                        {{#if @site.twitter}}<li><a href="https://twitter.com/{{@site.twitter}}" target="_blank" rel="noopener">Twitter</a></li>{{/if}}
                        <li><a href="{{@site.url}}/rss/" target="_blank" rel="noopener">RSS</a></li>
                        <li><a href="#/portal/signup" data-portal="signup">Subscribe</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <div>&copy; {{date format="YYYY"}} BLOCKYARD</div>
                <div>Published with Ghost</div>
            </div>
        </div>
    </footer>

    <script>
    (function () {
        var toggle = document.querySelector('.site-nav-toggle');
        var panel = document.getElementById('site-mobile-nav');
        var header = document.querySelector('.site-header');
        if (!toggle || !panel || !header) return;

        function setOpen(open) {
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            panel.setAttribute('aria-hidden', open ? 'false' : 'true');
            header.classList.toggle('site-header-open', open);
            document.body.classList.toggle('site-nav-open', open);
        }

        toggle.addEventListener('click', function (e) {
            e.stopPropagation();
            setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        panel.addEventListener('click', function (e) {
            if (e.target.tagName === 'A') setOpen(false);
        });

        document.addEventListener('click', function (e) {
            if (toggle.getAttribute('aria-expanded') !== 'true') return;
            if (!panel.contains(e.target) && !toggle.contains(e.target)) setOpen(false);
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
                setOpen(false);
                toggle.focus();
            }
        });

        window.addEventListener('resize', function () {
            if (window.innerWidth > 720 && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
        });
    })();
    </script>

    {{ghost_foot}}
</body>
</html>
