{
  "name": "blockyard",
  "description": "AI-native premium Ghost theme for BLOCKYARD",
  "version": "0.1.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "BLOCKYARD",
    "email": "info@blockyard.ai"
  },
  "keywords": ["ghost-theme", "blockyard", "premium"],
  "config": {
    "posts_per_page": 12,
    "image_sizes": {
      "xs": { "width": 150 },
      "s": { "width": 400 },
      "m": { "width": 750 },
      "l": { "width": 1140 },
      "xl": { "width": 2000 }
    },
    "card_assets": {
      "exclude": ["bookmark"]
    },
    "custom": {
      "accent_color": {
        "type": "color",
        "default": "#7C5CFF",
        "description": "Primary accent color (violet)"
      },
      "typography": {
        "type": "select",
        "options": ["Modern Serif", "Editorial Sans"],
        "default": "Editorial Sans"
      }
    }
  }
}
