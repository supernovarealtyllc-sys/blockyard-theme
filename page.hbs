{{!< default}}

{{#page}}
<article class="post-full">
    {{#if @page.show_title_and_feature_image}}
    <header class="post-full-header container">
        <span class="kicker">Page</span>
        <h1 class="post-full-title">{{title}}</h1>
    </header>

    {{#if feature_image}}
    <figure class="post-full-image">
        <img src="{{img_url feature_image size="l"}}" alt="{{title}}" loading="eager" fetchpriority="high" decoding="async" />
    </figure>
    {{/if}}
    {{/if}}

    <div class="post-full-content container-narrow">
        {{content}}
    </div>
</article>

{{> "subscribe-cta"}}
{{/page}}
