{{!< default}}

{{#tag}}
{{!-- BreadcrumbList + CollectionPage: tag pages are the section hubs
      (renttrust.ai, loantrust.ai, ...) and need their own entity surface. --}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{@site.url}}" },
                { "@type": "ListItem", "position": 2, "name": "{{name}}", "item": "{{url absolute="true"}}" }
            ]
        },
        {
            "@type": "CollectionPage",
            "@id": "{{url absolute="true"}}",
            "url": "{{url absolute="true"}}",
            "name": "{{name}} — {{@site.title}}",
            {{#if description}}"description": "{{description}}",{{/if}}
            "isPartOf": { "@id": "{{@site.url}}#website" },
            "inLanguage": "{{@site.locale}}"
        }
    ]
}
</script>

<section class="masthead container">
    <span class="kicker">Section</span>
    <h1>{{name}}</h1>
    {{#if description}}<p class="masthead-dek">{{description}}</p>{{/if}}
</section>
{{/tag}}

<section class="container feed">
    <div class="section-head">
        <h2>In this section</h2>
        <span class="kicker kicker--muted">{{plural pagination.total empty='No posts' singular='% post' plural='% posts'}}</span>
    </div>
    <div class="post-grid">
        {{#foreach posts}}
            {{#if @first}}{{> "post-card" eager=true}}{{else}}{{> "post-card"}}{{/if}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
