{{!< default}}

<article class="post-full">
    <header class="post-full-header container">
        <div class="post-full-meta">
            {{#if primary_tag}}<a class="post-card-kicker" href="{{primary_tag.url}}">{{primary_tag.name}}</a><span class="sep">/</span>{{/if}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
            <span class="sep">/</span>
            <span>{{reading_time}}</span>
        </div>
        <h1 class="post-full-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="post-full-dek">{{custom_excerpt}}</p>{{/if}}
    </header>

    {{#if feature_image}}
    <figure class="post-full-image">
        <img
            srcset="{{img_url feature_image size="m"}} 750w,
                    {{img_url feature_image size="l"}} 1140w,
                    {{img_url feature_image size="xl"}} 2000w"
            sizes="(max-width: 1140px) 100vw, 1140px"
            src="{{img_url feature_image size="l"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="post-full-content container-narrow">
        {{content}}
    </div>

    {{#if tags}}
    <div class="post-tags">
        {{#foreach tags}}<a class="post-tag-chip" href="{{url}}">{{name}}</a>{{/foreach}}
    </div>
    {{/if}}

    {{#foreach authors}}
    <div class="post-author container-narrow">
        {{#if profile_image}}<img class="post-author-avatar" src="{{profile_image}}" alt="{{name}}" />{{/if}}
        <div>
            <div class="post-author-name">{{name}}</div>
            {{#if bio}}<p class="post-author-bio">{{bio}}</p>{{/if}}
        </div>
    </div>
    {{/foreach}}
</article>

{{!-- Read next --}}
{{#get "posts" filter="id:-{{id}}+tags:[{{#if primary_tag}}{{primary_tag.slug}}{{else}}{{tags.[0].slug}}{{/if}}]" limit="3" as |related|}}
{{#if related}}
<section class="container read-next">
    <div class="section-head">
        <h2>Read next</h2>
        <span class="kicker kicker--muted">{{#if primary_tag}}More in {{primary_tag.name}}{{else}}From the yard{{/if}}</span>
    </div>
    <div class="post-grid">
        {{#foreach related}}
            {{> "post-card"}}
        {{/foreach}}
    </div>
</section>
{{/if}}
{{/get}}
